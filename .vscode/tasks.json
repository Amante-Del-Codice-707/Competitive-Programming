{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build cp file",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O2",
                "-Wall",
                "-Wextra",
                "-Wshadow",
                "-fsanitize=undefined,address",
                "-o",
                "${fileDirname}/sol",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
